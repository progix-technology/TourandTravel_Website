# ==========================================
# Root .gitignore for Tours & Travellers App
# ==========================================

# 1. Environment and Secret Files (Strictly Protect All Credentials)
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Dependency Directories
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/

# 3. Build & Output Directories
dist/
dist-ssr/
build/
frontend/dist/
backend/dist/

# 4. Logs and Diagnostic Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Database Backups and Local Dumps
local_dump/
dump/
backend/local_dump/
*.sql
*.sqlite

# 6. User Uploads / Media (Keep structure, ignore contents)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# 7. OS & IDE Configuration Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 8. SSL Keys & Certificates
*.pem
*.key
*.cert
*.crt
